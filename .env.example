# Environment

Copy to `.env` and fill in. Never commit `.env`.

# LI.FI (optional key for higher rate limits)
LIFI_API_BASE=https://li.quest/v1
LIFI_API_KEY=
LIFI_INTEGRATOR=lifi-x-keeperhub

# Default quote params (override via CLI)
LIFI_FROM_CHAIN=8453
LIFI_TO_CHAIN=8453
LIFI_FROM_TOKEN=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
LIFI_TO_TOKEN=0x4200000000000000000000000000000000000006
LIFI_FROM_AMOUNT=1000000
LIFI_FROM_ADDRESS=
LIFI_SLIPPAGE=0.03

# KeeperHub
KEEPERHUB_BASE_URL=
KEEPERHUB_API_KEY=
# or MCP / kh host profile — document which you use
KEEPERHUB_ORG_ID=
KEEPERHUB_NETWORK=base

# Safety
REQUIRE_CONFIRM=true
ALLOW_MAINNET=false
