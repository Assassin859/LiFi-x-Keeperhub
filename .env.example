# Environment
#
# Copy to `.env` and fill in. Never commit `.env`.
#
# KeeperHub: create an organisation API key (prefix kh_) at
# app.keeperhub.com → Settings → Developer → API keys → Organisation keys.
# Do not use webhook keys (wfb_) — they will 401 on /api/keys and /api/execute.

# LI.FI (optional key for higher rate limits)
LIFI_API_BASE=https://li.quest/v1
LIFI_API_KEY=
LIFI_INTEGRATOR=lifi-x-keeperhub

# Default quote params (override via CLI later)
# Base USDC → WETH (same-chain). LIFI_FROM_ADDRESS is required for /quote.
# Prefer KeeperHub org wallet for LIFI_FROM_ADDRESS (run:exec requires match unless --allow-from-mismatch).
LIFI_FROM_CHAIN=8453
LIFI_TO_CHAIN=8453
LIFI_FROM_TOKEN=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
LIFI_TO_TOKEN=0x4200000000000000000000000000000000000006
LIFI_FROM_AMOUNT=1000000
LIFI_FROM_ADDRESS=
LIFI_SLIPPAGE=0.03

# KeeperHub Direct Execution HTTP API (Phase 0 smoke + later execute)
KEEPERHUB_BASE_URL=https://app.keeperhub.com
KEEPERHUB_API_KEY=
KEEPERHUB_ORG_ID=
KEEPERHUB_NETWORK=base

# Safety
REQUIRE_CONFIRM=true
# Set true only when you intend to broadcast on mainnet (e.g. Base 8453).
ALLOW_MAINNET=false
# Dashboard / API bind (optional)
# API_PORT=8787
